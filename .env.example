# docker compose 与本地启动可用的环境变量示例。
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
#
# 这些变量通过 KOTOBA_ 前缀覆盖配置文件中的同名字段，
# 例如 KOTOBA_MYSQL_PASSWORD -> mysql.password。

# 运行环境：development | test | production
APP_ENV=development

# 宿主机端口映射
APP_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379

# MySQL（compose 中同时用于初始化容器与连接数据库）
MYSQL_ROOT_PASSWORD=kotoba_root
MYSQL_DATABASE=kotoba

# 时区：需与数据库保持一致
TZ=Asia/Shanghai

# 生产环境必须显式配置跨域白名单，多个来源用逗号分隔
# APP_ENV=production
# KOTOBA_APP_CORS_ALLOW_ORIGINS=https://kotoba.example.com
